# 复制为 .env 后填写。进程里已有的环境变量优先，.env 不覆盖它。
# 所有带 # 的行都是可选项，注释里是默认值。

# ---- 模型 provider：二选一，都存在时优先 OpenAI 兼容端点 ----
DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-chat
# DEEPSEEK_BASE_URL=https://api.deepseek.com   # 可换任何 OpenAI 兼容端点（Qwen、Kimi、vLLM...）

ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-6
# ANTHROPIC_BASE_URL=

# ---- 可选数据源 ----
# WEREAD_API_KEY=                              # 微信读书划线网关，缺失时降级到本地 txt

# ---- 运行契约 ----
# READING_COACH_HOME=./data                    # 数据根：coach.db / notes / highlights / 日志
# READING_COACH_ENV_FILE=                     # 显式指定 .env 路径；默认查 CWD 再查项目根
# READING_COACH_PORT=8765
# READING_COACH_BIND=127.0.0.1                # 只绑定回环地址，不要直接改成 0.0.0.0
# READING_COACH_TOKEN=                        # 非回环绑定时必填；浏览器用 HTTP Basic，用户名任意
# READING_COACH_ALLOWED_HOSTS=                # 反代场景追加 host:port，逗号分隔
# READING_COACH_TRUST_PROXY=1                 # 仅用于容器内 0.0.0.0 + 宿主机只映射回环端口
# READING_COACH_LOG_LEVEL=INFO
# PROACTIVE_RUNTIME_STORE=                    # 只读展示外部运行时影子决策的目录

# ---- 每日提醒（macOS 通知）----
# READING_COACH_NOTIFIER=                     # terminal-notifier 可执行文件路径
