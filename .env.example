# 复制为 .env 后填写。进程里已有的环境变量优先，.env 不覆盖它。
# 所有带 # 的行都是可选项，注释里是默认值。

# ---- BYOK：模型凭证由你自己提供 ----
# 本项目不提供、不代管、不转发模型服务，也不计费。
# 密钥只存在于本进程内存：不写盘、不进日志、不进数据库、不进页面。
# 通用写法，适用于任意 OpenAI 兼容端点（Qwen、Kimi、vLLM、Ollama...）
READING_COACH_API_KEY=
# READING_COACH_BASE_URL=https://your-endpoint/v1   # 用通用密钥时必填
# READING_COACH_MODEL=your-model-name               # 用通用密钥时必填
# READING_COACH_PROVIDER=auto                       # auto | openai | anthropic
# READING_COACH_THINKING=0                         # 1 强制下发厂商私有思考开关，0 强制不下发；默认按端点判断

# Anthropic Messages API（不走通用密钥时用它）
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-6
# ANTHROPIC_BASE_URL=

# 兼容别名：v3.1 及以前的写法仍然有效，无需迁移
# DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-chat
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# ---- 可选数据源（同样是 BYOK）----
# WEREAD_API_KEY=                              # 微信读书划线网关，缺失时降级到本地 txt

# ---- 运行契约 ----
# READING_COACH_HOME=./data                    # 数据根：coach.db / notes / highlights / 日志
# READING_COACH_ENV_FILE=                     # 显式指定 .env 路径；默认查 CWD 再查项目根
# READING_COACH_PORT=8765
# READING_COACH_BIND=127.0.0.1                # 只绑定回环地址，不要直接改成 0.0.0.0
# READING_COACH_TOKEN=                        # 非回环绑定时必填；浏览器用 HTTP Basic，用户名任意
# READING_COACH_ALLOWED_HOSTS=                # 反代场景追加 host:port，逗号分隔
# READING_COACH_TRUST_PROXY=1                 # 仅用于容器内 0.0.0.0 + 宿主机只映射回环端口
# READING_COACH_LOG_LEVEL=INFO
# PROACTIVE_RUNTIME_STORE=                    # 只读展示外部运行时影子决策的目录

# ---- 每日提醒（macOS 通知）----
# READING_COACH_NOTIFIER=                     # terminal-notifier 可执行文件路径
